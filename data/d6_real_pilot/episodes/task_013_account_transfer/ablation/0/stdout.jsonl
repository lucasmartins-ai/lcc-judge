{"type": "result", "session_id": "20261003_211417_d0ab92", "exit_code": 0, "text": "{\"status\":\"ANSWER\",\"answer\":\"Serialize each transfer inside a transaction and lock all involved account rows before checking or changing balances.\",\"mechanism\":null,\"parameters\":{},\"python\":\"def transfer(from_acc, to_acc, amount):\\n    if amount < 0:\\n        raise ValueError(\\\"amount must be non-negative\\\")\\n\\n    with db.transaction():\\n        balances = {}\\n        for account_id in sorted({from_acc, to_acc}):\\n            balances[account_id] = db.query(\\n                \\\"SELECT balance FROM accounts WHERE id = ? FOR UPDATE\\\",\\n                account_id,\\n            )\\n\\n        if balances[from_acc] is None or balances[to_acc] is None:\\n            raise ValueError(\\\"account not found\\\")\\n        if balances[from_acc] < amount:\\n            return False\\n        if from_acc == to_acc or amount == 0:\\n            return True\\n\\n        db.execute(\\n            \\\"UPDATE accounts SET balance = balance - ? WHERE id = ?\\\",\\n            amount,\\n            from_acc,\\n        )\\n        db.execute(\\n            \\\"UPDATE accounts SET balance = balance + ? WHERE id = ?\\\",\\n            amount,\\n            to_acc,\\n        )\\n        return True\"}", "tokens": {"input": 982, "output": 3932, "total": 5054, "cache_read": 140, "cache_write": 0}, "duration_ms": 48149, "timestamp": 1791058505950}

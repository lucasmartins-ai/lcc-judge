{"type": "result", "session_id": "20261003_211533_c1d9e6", "exit_code": 0, "text": "{\"status\":\"ANSWER\",\"answer\":\"Use a shared closure to track water level and last leak time; the first request sees a full bucket. For the stated target, pass leak_rate=100/60 and capacity=150.\",\"mechanism\":null,\"parameters\":{\"leak_rate\":\"requests per second (100/60 for the stated limit)\",\"capacity\":150,\"clock\":\"callable returning seconds\"},\"python\":\"def rate_limit(leak_rate, capacity, clock):\\n    if leak_rate < 0:\\n        raise ValueError(\\\"leak_rate must be non-negative\\\")\\n    if capacity < 0:\\n        raise ValueError(\\\"capacity must be non-negative\\\")\\n\\n    def decorator(func):\\n        water = 0.0\\n        last_leak = None\\n\\n        def wrapped(*args, **kwargs):\\n            nonlocal water, last_leak\\n            now = clock()\\n            if last_leak is not None:\\n                water = max(0.0, water - (now - last_leak) * leak_rate)\\n            last_leak = now\\n\\n            if water + 1 <= capacity:\\n                water += 1.0\\n                return func(*args, **kwargs)\\n            return False\\n\\n        return wrapped\\n\\n    return decorator\\n\"}", "tokens": {"input": 1028, "output": 1219, "total": 2387, "cache_read": 140, "cache_write": 0}, "duration_ms": 15032, "timestamp": 1791058548733}

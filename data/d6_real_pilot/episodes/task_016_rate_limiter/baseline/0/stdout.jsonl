{"type": "result", "session_id": "20261003_211524_19c685", "exit_code": 0, "text": "{\"status\":\"ANSWER\",\"answer\":\"A closure-backed leaky bucket enforces the supplied requests-per-second leak rate and burst capacity; use 100/60 for the stated 100 requests per minute.\",\"mechanism\":null,\"parameters\":{},\"python\":\"from functools import wraps\\n\\ndef rate_limit(leak_rate, capacity, clock):\\n    water = 0.0\\n    last_leak = None\\n\\n    def decorator(func):\\n        @wraps(func)\\n        def wrapped(*args, **kwargs):\\n            nonlocal water, last_leak\\n\\n            now = clock()\\n            if last_leak is not None:\\n                water = max(0.0, water - (now - last_leak) * leak_rate)\\n            last_leak = now\\n\\n            if water + 1 <= capacity:\\n                water += 1\\n                return func(*args, **kwargs)\\n            return False\\n\\n        return wrapped\\n\\n    return decorator\"}", "tokens": {"input": 1028, "output": 2845, "total": 4013, "cache_read": 140, "cache_write": 0}, "duration_ms": 43621, "timestamp": 1791058568534}

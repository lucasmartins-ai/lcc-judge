{"type": "result", "session_id": "20261003_211528_de67ba", "exit_code": 0, "text": "{\"status\":\"ANSWER\",\"answer\":\"Maintains an independent, thread-safe leaky-bucket state for each decorated callable.\",\"mechanism\":null,\"parameters\":{},\"python\":\"from functools import wraps\\nfrom threading import Lock\\n\\n\\ndef rate_limit(leak_rate, capacity, clock):\\n    if leak_rate < 0:\\n        raise ValueError(\\\"leak_rate must be non-negative\\\")\\n    if capacity < 0:\\n        raise ValueError(\\\"capacity must be non-negative\\\")\\n\\n    def decorator(func):\\n        water = 0\\n        last_leak = None\\n        lock = Lock()\\n\\n        @wraps(func)\\n        def wrapper(*args, **kwargs):\\n            nonlocal water, last_leak\\n\\n            with lock:\\n                now = clock()\\n                if last_leak is None:\\n                    last_leak = now\\n                else:\\n                    if now < last_leak:\\n                        now = last_leak\\n                    water = max(0, water - (now - last_leak) * leak_rate)\\n                    last_leak = now\\n\\n                if water + 1 <= capacity:\\n                    water += 1\\n                    admitted = True\\n                else:\\n                    admitted = False\\n\\n            return func(*args, **kwargs) if admitted else False\\n\\n        return wrapper\\n\\n    return decorator\\n\"}", "tokens": {"input": 1028, "output": 1689, "total": 2857, "cache_read": 140, "cache_write": 0}, "duration_ms": 18461, "timestamp": 1791058547370}

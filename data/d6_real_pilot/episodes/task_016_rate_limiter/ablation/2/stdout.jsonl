{"type": "result", "session_id": "20261003_211610_87c298", "exit_code": 0, "text": "{\"status\":\"ANSWER\",\"answer\":\"Use a thread-safe token bucket that starts full; leak_rate is tokens per second, so configure 100/60 with capacity 150.\",\"mechanism\":null,\"parameters\":{\"leak_rate\":1.6666666666666667,\"capacity\":150},\"python\":\"from functools import wraps\\nfrom threading import Lock\\n\\n\\ndef rate_limit(leak_rate, capacity, clock):\\n    if leak_rate <= 0:\\n        raise ValueError(\\\"leak_rate must be positive\\\")\\n    if capacity < 0:\\n        raise ValueError(\\\"capacity cannot be negative\\\")\\n\\n    def decorator(func):\\n        state = {\\\"tokens\\\": float(capacity), \\\"updated_at\\\": None}\\n        lock = Lock()\\n\\n        @wraps(func)\\n        def wrapper(*args, **kwargs):\\n            now = clock()\\n            with lock:\\n                if state[\\\"updated_at\\\"] is None:\\n                    state[\\\"updated_at\\\"] = now\\n                else:\\n                    elapsed = max(0.0, now - state[\\\"updated_at\\\"])\\n                    state[\\\"tokens\\\"] = min(\\n                        float(capacity),\\n                        state[\\\"tokens\\\"] + elapsed * leak_rate,\\n                    )\\n                    state[\\\"updated_at\\\"] = now\\n\\n                if state[\\\"tokens\\\"] < 1.0:\\n                    return False\\n                state[\\\"tokens\\\"] -= 1.0\\n\\n            return func(*args, **kwargs)\\n\\n        return wrapper\\n\\n    return decorator\\n\\n# Target configuration: 100 requests/minute, burst capacity 150.\\n# @rate_limit(leak_rate=100 / 60, capacity=150, clock=time.monotonic)\"}}", "tokens": {"input": 956, "output": 1415, "total": 2511, "cache_read": 140, "cache_write": 0}, "duration_ms": 16426, "timestamp": 1791058587332}

{"type": "result", "session_id": "20261003_211133_6a299c", "exit_code": 0, "text": "{\"status\":\"ANSWER\",\"answer\":\"Uses Redis GET plus an atomic SET NX EX 120 claim, returns cached receipts, and stores successful charge receipts for 120 seconds.\",\"mechanism\":null,\"parameters\":{},\"python\":\"def process_payment(idempotency_key, amount):\\n    import json\\n\\n    cache_key = f'idemp:{idempotency_key}'\\n\\n    def decode(value):\\n        if isinstance(value, bytes):\\n            value = value.decode('utf-8')\\n        return json.loads(value) if isinstance(value, str) else value\\n\\n    while True:\\n        cached = redis.get(cache_key)\\n        if cached is not None:\\n            return decode(cached)\\n\\n        claimed = redis.set(\\n            cache_key,\\n            json.dumps({'status': 'processing'}),\\n            nx=True,\\n            ex=120,\\n        )\\n        if claimed:\\n            break\\n\\n    receipt = stripe.Charge.create(amount=amount)\\n    redis.set(cache_key, json.dumps(receipt), ex=120)\\n    return receipt\"}", "tokens": {"input": 1049, "output": 6305, "total": 7494, "cache_read": 140, "cache_write": 0}, "duration_ms": 68890, "timestamp": 1791058362975}

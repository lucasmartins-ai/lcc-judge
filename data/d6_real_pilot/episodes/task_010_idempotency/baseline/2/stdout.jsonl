{"type": "result", "session_id": "20261003_211134_3a6112", "exit_code": 0, "text": "{\"status\":\"ANSWER\",\"answer\":\"Uses an atomic Redis reservation before charging, caches the receipt for 120 seconds, and waits for an in-flight duplicate.\",\"mechanism\":null,\"parameters\":{},\"python\":\"import json\\nimport time\\n\\ndef process_payment(idempotency_key, amount):\\n    cache_key = f'idemp:{idempotency_key}'\\n    processing_value = '__idempotency_processing__'\\n\\n    while True:\\n        if redis.set(cache_key, processing_value, nx=True, ex=120):\\n            receipt = stripe.Charge.create(amount=amount)\\n            redis.set(cache_key, json.dumps(receipt), ex=120)\\n            return receipt\\n\\n        cached = redis.get(cache_key)\\n        if cached is None:\\n            continue\\n        if isinstance(cached, (bytes, bytearray)):\\n            cached = cached.decode('utf-8')\\n        if cached == processing_value:\\n            time.sleep(0.05)\\n            continue\\n        return json.loads(cached) if isinstance(cached, str) else cached\\n\"}", "tokens": {"input": 1049, "output": 7829, "total": 9018, "cache_read": 140, "cache_write": 0}, "duration_ms": 78713, "timestamp": 1791058373505}

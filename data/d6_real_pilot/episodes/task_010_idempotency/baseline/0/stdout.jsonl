{"type": "result", "session_id": "20261003_211133_902785", "exit_code": 0, "text": "{\"status\":\"ANSWER\",\"answer\":\"Atomically claim the idempotency key before charging, cache the successful receipt for 120 seconds, and return cached receipts on retries.\",\"mechanism\":null,\"parameters\":{\"ttl_seconds\":120,\"pending_poll_seconds\":0.01,\"pending_timeout_seconds\":120},\"python\":\"def process_payment(idempotency_key, amount):\\n    import json\\n    import time\\n\\n    cache_key = f\\\"idemp:{idempotency_key}\\\"\\n    pending_marker = \\\"__IDEMPOTENCY_PENDING__\\\"\\n    deadline = time.monotonic() + 120\\n\\n    while True:\\n        claimed = redis.set(cache_key, pending_marker, nx=True, ex=120)\\n        if claimed:\\n            receipt = stripe.Charge.create(amount=amount)\\n            redis.set(cache_key, json.dumps(receipt), ex=120)\\n            return receipt\\n\\n        cached = redis.get(cache_key)\\n        if cached is None:\\n            continue\\n        if isinstance(cached, bytes):\\n            cached = cached.decode(\\\"utf-8\\\")\\n        if cached != pending_marker:\\n            return json.loads(cached)\\n        if time.monotonic() >= deadline:\\n            raise TimeoutError(\\\"Timed out waiting for the cached payment receipt\\\")\\n        time.sleep(0.01)\"}", "tokens": {"input": 1049, "output": 3394, "total": 4583, "cache_read": 140, "cache_write": 0}, "duration_ms": 51237, "timestamp": 1791058344947}

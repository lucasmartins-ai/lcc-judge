{"type": "result", "session_id": "20261004_114129_e1e73f", "exit_code": 0, "text": "{\"status\":\"ANSWER\",\"answer\":\"Use a per-function leaky-bucket closure. Configure 100 requests/minute as leak_rate=100/60 requests/second and capacity=150.\",\"mechanism\":null,\"parameters\":{\"leak_rate\":1.6666666666666667,\"capacity\":150},\"python\":\"from functools import wraps\\n\\ndef rate_limit(leak_rate, capacity, clock):\\n    def decorator(func):\\n        water = 0\\n        last_leak = clock()\\n\\n        @wraps(func)\\n        def limited(*args, **kwargs):\\n            nonlocal water, last_leak\\n            now = clock()\\n            water = max(0, water - (now - last_leak) * leak_rate)\\n            last_leak = now\\n            if water + 1 <= capacity:\\n                water += 1\\n                return func(*args, **kwargs)\\n            return False\\n\\n        return limited\\n\\n    return decorator\"}", "tokens": {"input": 1021, "output": 4874, "total": 6035, "cache_read": 140, "cache_write": 0}, "duration_ms": 56608, "timestamp": 1791110546351}

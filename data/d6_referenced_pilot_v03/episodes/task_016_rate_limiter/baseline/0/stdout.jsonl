{"type": "result", "session_id": "20261004_114124_9b60cd", "exit_code": 0, "text": "{\"status\":\"ANSWER\",\"answer\":\"Closure-managed, thread-safe leaky bucket using the specified leak and capacity rules.\",\"mechanism\":null,\"parameters\":{},\"python\":\"from functools import wraps\\nfrom threading import Lock\\n\\n\\ndef rate_limit(leak_rate, capacity, clock):\\n    if leak_rate < 0:\\n        raise ValueError(\\\"leak_rate must be non-negative\\\")\\n    if capacity <= 0:\\n        raise ValueError(\\\"capacity must be positive\\\")\\n\\n    def decorator(func):\\n        water = 0.0\\n        last_leak = None\\n        lock = Lock()\\n\\n        @wraps(func)\\n        def wrapper(*args, **kwargs):\\n            nonlocal water, last_leak\\n\\n            with lock:\\n                now = clock()\\n                if last_leak is None:\\n                    last_leak = now\\n                else:\\n                    elapsed = max(0.0, now - last_leak)\\n                    water = max(0.0, water - elapsed * leak_rate)\\n                    last_leak = now\\n\\n                if water + 1 > capacity:\\n                    return False\\n                water += 1\\n\\n            return func(*args, **kwargs)\\n\\n        return wrapper\\n\\n    return decorator\"}", "tokens": {"input": 1021, "output": 2330, "total": 3491, "cache_read": 140, "cache_write": 0}, "duration_ms": 29245, "timestamp": 1791110514021}

{"type": "result", "session_id": "20261004_114127_1e9eef", "exit_code": 0, "text": "{\"status\":\"ANSWER\",\"answer\":\"Use rate_limit(100 / 60, 150, clock) for 100 requests per minute with a burst capacity of 150.\",\"mechanism\":null,\"parameters\":{\"leak_rate\":1.6666666666666667,\"capacity\":150},\"python\":\"from functools import wraps\\nfrom threading import Lock\\n\\ndef rate_limit(leak_rate, capacity, clock):\\n    if leak_rate < 0:\\n        raise ValueError(\\\"leak_rate must be non-negative\\\")\\n    if capacity < 1:\\n        raise ValueError(\\\"capacity must be positive\\\")\\n\\n    def decorator(func):\\n        water = 0.0\\n        last_leak = None\\n        lock = Lock()\\n\\n        @wraps(func)\\n        def wrapper(*args, **kwargs):\\n            nonlocal water, last_leak\\n\\n            with lock:\\n                now = clock()\\n                if last_leak is None:\\n                    last_leak = now\\n                elapsed = max(0.0, now - last_leak)\\n                water = max(0.0, water - elapsed * leak_rate)\\n                last_leak = now\\n\\n                if water + 1 > capacity:\\n                    return False\\n                water += 1\\n\\n            return func(*args, **kwargs)\\n\\n        return wrapper\\n\\n    return decorator\"}", "tokens": {"input": 1021, "output": 1848, "total": 3009, "cache_read": 140, "cache_write": 0}, "duration_ms": 22121, "timestamp": 1791110509886}

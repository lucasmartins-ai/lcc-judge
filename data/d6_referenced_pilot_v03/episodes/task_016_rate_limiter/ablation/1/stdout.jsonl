{"type": "result", "session_id": "20261004_114156_ca75d2", "exit_code": 0, "text": "{\"status\":\"ANSWER\",\"answer\":\"Use a thread-safe leaky-bucket decorator; invoke it as rate_limit(100 / 60, 150, clock) for 100 requests per minute with a burst capacity of 150.\",\"mechanism\":null,\"parameters\":{},\"python\":\"import threading\\n\\ndef rate_limit(leak_rate, capacity, clock):\\n    if leak_rate <= 0:\\n        raise ValueError(\\\"leak_rate must be positive\\\")\\n    if capacity <= 0:\\n        raise ValueError(\\\"capacity must be positive\\\")\\n    if not callable(clock):\\n        raise TypeError(\\\"clock must be callable\\\")\\n\\n    state = {\\\"level\\\": 0.0, \\\"last_time\\\": None}\\n    lock = threading.Lock()\\n\\n    def decorator(func):\\n        @functools.wraps(func)\\n        def wrapper(*args, **kwargs):\\n            now = clock()\\n            with lock:\\n                if state[\\\"last_time\\\"] is not None:\\n                    elapsed = max(0.0, now - state[\\\"last_time\\\"])\\n                    state[\\\"level\\\"] = max(\\n                        0.0, state[\\\"level\\\"] - elapsed * leak_rate\\n                    )\\n                state[\\\"last_time\\\"] = now\\n\\n                if state[\\\"level\\\"] + 1.0 <= capacity:\\n                    state[\\\"level\\\"] += 1.0\\n                    admitted = True\\n                else:\\n                    admitted = False\\n\\n            if not admitted:\\n                return False\\n            return func(*args, **kwargs)\\n\\n        return wrapper\\n\\n    return decorator\"}", "tokens": {"input": 949, "output": 1210, "total": 2299, "cache_read": 140, "cache_write": 0}, "duration_ms": 16998, "timestamp": 1791110533693}

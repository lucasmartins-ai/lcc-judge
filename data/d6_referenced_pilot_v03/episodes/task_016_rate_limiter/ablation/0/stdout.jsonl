{"type": "result", "session_id": "20261004_114152_041c61", "exit_code": 0, "text": "{\"status\":\"ANSWER\",\"answer\":\"Use a thread-safe leaky bucket. Pass leak_rate as requests per second, so 100 requests/minute is 100/60; use capacity=150.\",\"mechanism\":null,\"parameters\":{\"leak_rate\":1.6666666666666667,\"capacity\":150,\"units\":\"requests_per_second\"},\"python\":\"def rate_limit(leak_rate, capacity, clock):\\n    from functools import wraps\\n    from threading import Lock\\n\\n    def decorator(func):\\n        level = 0.0\\n        last_time = None\\n        lock = Lock()\\n\\n        @wraps(func)\\n        def wrapped(*args, **kwargs):\\n            nonlocal level, last_time\\n            with lock:\\n                now = clock()\\n                if last_time is not None:\\n                    elapsed = max(0.0, now - last_time)\\n                    level = min(float(capacity), level + elapsed * leak_rate)\\n                last_time = now\\n\\n                if level + 1.0 > capacity:\\n                    return False\\n                level += 1.0\\n\\n            return func(*args, **kwargs)\\n\\n        return wrapped\\n\\n    return decorator\"}", "tokens": {"input": 949, "output": 1604, "total": 2693, "cache_read": 140, "cache_write": 0}, "duration_ms": 22544, "timestamp": 1791110535292}

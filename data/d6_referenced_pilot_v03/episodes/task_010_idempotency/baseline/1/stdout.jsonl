{"type": "result", "session_id": "20261004_113627_77215a", "exit_code": 0, "text": "{\"status\":\"ANSWER\",\"answer\":\"Atomically claim a 120-second Redis key before charging, cache the receipt, and return it for duplicate requests.\",\"mechanism\":null,\"parameters\":{},\"python\":\"def process_payment(idempotency_key, amount):\\n    import json\\n    import time\\n\\n    cache_key = f'idemp:{idempotency_key}'\\n    pending = '__PAYMENT_PENDING__'\\n\\n    while True:\\n        claimed = redis.set(cache_key, pending, nx=True, ex=120)\\n        if claimed:\\n            receipt = stripe.Charge.create(amount=amount)\\n            redis.set(cache_key, json.dumps(receipt), ex=120)\\n            return receipt\\n\\n        cached = redis.get(cache_key)\\n        if cached is None:\\n            continue\\n        if isinstance(cached, bytes):\\n            cached = cached.decode('utf-8')\\n        if isinstance(cached, str):\\n            if cached == pending:\\n                time.sleep(0.01)\\n                continue\\n            return json.loads(cached)\\n        return cached\"}", "tokens": {"input": 1042, "output": 5904, "total": 7086, "cache_read": 140, "cache_write": 0}, "duration_ms": 91517, "timestamp": 1791110278950}

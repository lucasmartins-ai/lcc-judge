{"type": "result", "session_id": "20261004_114401_d5284e", "exit_code": 0, "text": "{\"status\":\"ANSWER\",\"answer\":\"Verify that five initial requests are allowed, the sixth is rejected, and one request is allowed again after one second of controlled clock time.\",\"mechanism\":null,\"parameters\":{\"capacity\":5,\"refill_rate\":1.0,\"elapsed_seconds\":1.0},\"python\":\"def test_burst(TokenBucket):\\n    import unittest\\n\\n    case = unittest.TestCase()\\n    now = [0.0]\\n    bucket = TokenBucket(5, 1.0, lambda: now[0])\\n\\n    for request_number in range(1, 6):\\n        case.assertTrue(\\n            bucket.allow(),\\n            f\\\"burst request {request_number} should be allowed\\\",\\n        )\\n\\n    case.assertFalse(bucket.allow(), \\\"request beyond burst capacity should be rejected\\\")\\n\\n    now[0] += 1.0\\n    case.assertTrue(bucket.allow(), \\\"one token should refill after one second\\\")\\n    case.assertFalse(bucket.allow(), \\\"the refilled token should be consumed\\\")\"}", "tokens": {"input": 957, "output": 1170, "total": 2267, "cache_read": 140, "cache_write": 0}, "duration_ms": 17340, "timestamp": 1791110659490}
